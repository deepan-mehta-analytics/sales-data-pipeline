# =============================================================================
# .env.example
# Copy to .env before running the Airflow stack: cp .env.example .env
# .env is gitignored — never commit real credentials, even local-dev ones.
# =============================================================================

# Host UID Airflow's containers run as. On Linux this must match your host
# user (run: id -u) so mounted volumes aren't owned by root. Docker Desktop
# on Windows/Mac ignores this safely — the default below is fine there.
AIRFLOW_UID=50000

# Local-only Airflow admin login — never used outside your machine.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# BigQuery sync (v2.0) — used only by the load_bigquery Airflow task; never by
# orchestration/pipeline.py or the GitHub Actions daily cron, which never touch GCP.
GCP_PROJECT_ID=sales-data-pipeline-dm
BQ_DATASET_ID=superstore_analytics

# Shown for reference only — docker-compose.yml hardcodes this container-internal path, so
# setting it here (or exporting it in your host shell, e.g. after `gcloud auth application-default
# login`) has no effect. Just drop your service-account key at ./credentials/gcp-service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/project/credentials/gcp-service-account.json
